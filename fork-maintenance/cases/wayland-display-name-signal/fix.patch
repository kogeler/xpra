+# later version. See the file COPYING for details.
+
+import os
+import stat
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from xpra.util import signal_emitter
+from xpra.wayland.server.subsystem.manager import WaylandManager
+
+
+class WaylandManagerSignalTest(unittest.TestCase):
+
+    def test_native_socket_binding_notifies_without_warning(self):
+        with TemporaryDirectory(prefix="xpra-manager-signal-") as runtime:
+            with patch.dict(os.environ, {
+                "XDG_RUNTIME_DIR": runtime,
+                "XPRA_WAYLAND_GPU": "no",
+                "WLR_RENDERER": "pixman",
+            }), patch.object(signal_emitter, "log", wraps=signal_emitter.log) as logger:
+                manager = WaylandManager()
+                notifications = []
+                progress = []
+
+                def display_name_changed(emitter, name):
+                    notifications.append((emitter, name, os.environ.get("WAYLAND_DISPLAY"), manager.started))
+
+                try:
+                    # The native subject must import and bind a real socket, never skip.
+                    manager.init(SimpleNamespace(displayfd=0))
+                    manager.connect("display-name", display_name_changed)
+                    result = manager.setup_display(lambda *args: progress.append(args))
+                    socket = Path(runtime) / result.display_name
+                    identity = socket.stat()
+                    self.assertTrue(stat.S_ISSOCK(identity.st_mode))
+                    self.assertEqual(notifications, [(manager, result.display_name, result.display_name, False)])
+                    self.assertEqual(result.displayfd, 0)
+                    self.assertEqual(progress, [(40, "binding the wayland display socket")])
+                    self.assertFalse(manager.started)
+
+                    repeated = manager.setup_display(lambda *_args: None)
+                    self.assertEqual(repeated, result)
+                    self.assertEqual(socket.stat().st_ino, identity.st_ino)
+                    self.assertEqual(notifications, notifications[:1] * 2)
+                    logger.warn.assert_not_called()
+                finally:
+                    manager.cleanup()
+                    manager.cleanup()
+                self.assertIsNone(manager.compositor)
+                self.assertFalse(socket.exists())
+
+    def test_failed_binding_does_not_emit_a_display_name(self):
+        manager = WaylandManager()
+        allocate = Mock(side_effect=OSError("test socket allocation failure"))
+        manager.compositor = SimpleNamespace(add_socket=allocate)
+        observed = []
+        with patch.dict(os.environ), patch.object(signal_emitter, "log", wraps=signal_emitter.log) as logger:
+            before = os.environ.get("WAYLAND_DISPLAY")
+            manager.connect("display-name", lambda _emitter, name: observed.append(name))
+            with self.assertRaisesRegex(OSError, "test socket allocation failure"):
+                manager.setup_display(lambda *_args: None)
+            self.assertEqual(observed, [])
+            self.assertEqual(manager.socket_name, "")
+            self.assertEqual(os.environ.get("WAYLAND_DISPLAY"), before)
+            self.assertFalse(manager.started)
+            allocate.assert_called_once_with()
+            logger.warn.assert_not_called()
+
+    def test_unknown_signal_still_warns(self):
+        manager = WaylandManager()
+        with patch.object(signal_emitter, "log", wraps=signal_emitter.log) as logger:
+            manager.emit("display-name-typo", "wayland-test")
+            logger.warn.assert_called_once_with(
+                "Warning: %r is not a declared signal of %s", "display-name-typo", "WaylandManager",
+            )
+
+
+def main():
+    unittest.main()
+
+
+if __name__ == "__main__":
+    main()
