diff --git a/packaging/debian/xpra/not-installed b/packaging/debian/xpra/not-installed
new file mode 100644
index 0000000000000000000000000000000000000000..b53673f5813841c5db45dd8699484a0d7f588780
--- /dev/null
+++ b/packaging/debian/xpra/not-installed
@@ -0,0 +1,12 @@
+# Debian installs its package-specific xpra-server units through debhelper.
+lib/systemd/system/xpra.service
+lib/systemd/system/xpra.socket
+
+# The system encoder service has no Debian lifecycle integration yet.
+lib/systemd/system/xpra-encoder.service
+lib/systemd/system/xpra-encoder.socket
+
+# setup.py cannot resolve a versioned Wireshark plugin directory without the
+# optional Wireshark development environment and otherwise stages this at an
+# invalid top-level location.
+usr/xpra_dissector.lua
