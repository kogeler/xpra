+class SelectionRefusalTest(unittest.TestCase):
+    """Keep process-global X11/GDK connections out of the surrounding suite."""
+
+    def run_native(self, mode, **env):
+        result = subprocess.run(
+            (sys.executable, __file__, mode), capture_output=True, text=True,
+            env=dict(os.environ, PYTHONPATH=os.pathsep.join(sys.path), **env),
+            timeout=90, check=False,
+        )
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("native-selection-refusal=passed", result.stdout)
+
+    def test_gtk_native_conversions(self):
+        self.run_native("--gtk")
+
+    def test_raw_x11_native_conversions_without_gtk(self):
+        ProcessTestUtil.setUpClass()
+        try:
+            runner = ProcessTestUtil()
+            xvfb = runner.start_Xvfb()
+            self.run_native("--raw", DISPLAY=xvfb.display, XPRA_GTK="0")
+        finally:
+            ProcessTestUtil.tearDownClass()
+
+
+def load_tests(_loader, _tests, _pattern):
+    return unittest.defaultTestLoader.loadTestsFromTestCase(SelectionRefusalTest)
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] in (["--gtk"], ["--raw"]):
+        suite = unittest.defaultTestLoader.loadTestsFromTestCase(NativeSelectionRefusalTest)
+        # Prove the original native refusal before exercising newer lifetime
+        # and INCR helpers. The same order and fail-fast apply to both sources;
+        # every one of the 21 methods still runs on a successful candidate.
+        first = NativeSelectionRefusalTest("test_refused_aliases_and_targets_complete_without_timeout")
+        suite = unittest.TestSuite((first, *(test for test in suite if test.id() != first.id())))
+        result = unittest.TextTestRunner(verbosity=2, failfast=True).run(suite)
+        if result.wasSuccessful():
+            print("native-selection-refusal=passed")
+        sys.exit(not result.wasSuccessful())
+    unittest.main()
