+"""Real X11 conversion replies through the compiled parser and GDK filter."""
+
+import ctypes as C
+import os
+import subprocess
+import sys
+import time
+import unittest
+from unittest.mock import patch
+
+from xpra.os_util import gi_import
+from unit.process_test_util import DisplayContext, ProcessTestUtil
+
+GLib = gi_import("GLib")
+DISPLAY = C.c_void_p
+XID = C.c_ulong
+RAW_NATIVE = sys.argv[1:] == ["--raw"]
+
+
+class SelectionRequest(C.Structure):
+    _fields_ = [
+        ("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
+        ("display", DISPLAY), ("owner", XID), ("requestor", XID),
+        ("selection", XID), ("target", XID), ("property", XID), ("time", XID),
+    ]
+
+
+class SelectionNotify(C.Structure):
+    _fields_ = [
+        ("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
+        ("display", DISPLAY), ("requestor", XID), ("selection", XID),
+        ("target", XID), ("property", XID), ("time", XID),
+    ]
+
+
+class PropertyNotify(C.Structure):
+    _fields_ = [
+        ("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
+        ("display", DISPLAY), ("window", XID), ("atom", XID),
+        ("time", XID), ("state", C.c_int),
+    ]
+
+
+class XEvent(C.Union):
+    _fields_ = [
+        ("type", C.c_int), ("request", SelectionRequest),
+        ("selection", SelectionNotify), ("property", PropertyNotify),
+        ("pad", C.c_long * 24),
+    ]
+
+
+class XErrorEvent(C.Structure):
+    _fields_ = [
+        ("type", C.c_int), ("display", DISPLAY), ("resource", XID),
+        ("serial", C.c_ulong), ("code", C.c_ubyte),
+        ("request", C.c_ubyte), ("minor", C.c_ubyte),
+    ]
+
+
+def spin_until(predicate, timeout=1.0):
+    context = GLib.MainContext.default()
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        while context.pending():
+            context.iteration(False)
+        if predicate():
+            return True
+        time.sleep(0.001)
+    return bool(predicate())
+
+
+class Owner:
+    """Independent Xlib connection: no Xpra parser or reply helper on this side."""
+
+    def __init__(self):
+        self.lib = C.CDLL("libX11.so.6")
+        declarations = {
+            "XOpenDisplay": ([C.c_char_p], DISPLAY),
+            "XCloseDisplay": ([DISPLAY], C.c_int),
+            "XDefaultRootWindow": ([DISPLAY], XID),
+            "XCreateSimpleWindow": ([DISPLAY, XID, C.c_int, C.c_int, C.c_uint,
+                                      C.c_uint, C.c_uint, XID, XID], XID),
+            "XDestroyWindow": ([DISPLAY, XID], C.c_int),
+            "XInternAtom": ([DISPLAY, C.c_char_p, C.c_int], XID),
+            "XSetSelectionOwner": ([DISPLAY, XID, XID, XID], C.c_int),
+            "XGetSelectionOwner": ([DISPLAY, XID], XID),
+            "XChangeProperty": ([DISPLAY, XID, XID, XID, C.c_int, C.c_int,
+                                  C.c_void_p, C.c_int], C.c_int),
+            "XSelectInput": ([DISPLAY, XID, C.c_long], C.c_int),
+            "XSendEvent": ([DISPLAY, XID, C.c_int, C.c_long, C.POINTER(XEvent)], C.c_int),
+            "XPending": ([DISPLAY], C.c_int),
+            "XNextEvent": ([DISPLAY, C.POINTER(XEvent)], C.c_int),
+            "XConnectionNumber": ([DISPLAY], C.c_int),
+            "XFlush": ([DISPLAY], C.c_int),
+            "XSync": ([DISPLAY, C.c_int], C.c_int),
+            "XSetErrorHandler": ([C.c_void_p], C.c_void_p),
+        }
+        for name, (args, result) in declarations.items():
+            function = getattr(self.lib, name)
+            function.argtypes, function.restype = args, result
+        self.display = self.lib.XOpenDisplay(None)
+        assert self.display
+        self.root = self.lib.XDefaultRootWindow(self.display)
+        self.window = self.lib.XCreateSimpleWindow(self.display, self.root, 0, 0, 1, 1, 0, 0, 0)
+        self.requests = []
+        self.errors = []
+        self.incr = {}
+        self.incr_deletes = []
+        self.property_deletes = []
+        self.pause_incr = False
+        self.mode = "hold"
+        self.data = b"one clipboard line"
+        self.error_handler = C.CFUNCTYPE(C.c_int, DISPLAY, C.POINTER(XErrorEvent))(self.xerror)
+        self.previous_handler = self.lib.XSetErrorHandler(self.error_handler)
+        self.watch = GLib.io_add_watch(self.lib.XConnectionNumber(self.display), GLib.PRIORITY_DEFAULT,
+                                       GLib.IO_IN, self.events)
+        for selection in ("CLIPBOARD", "PRIMARY"):
+            self.claim(selection, self.window)
+
+    def xerror(self, _display, event):
+        self.errors.append((event.contents.code, event.contents.resource))
+        return 0
+
+    def atom(self, name):
+        return self.lib.XInternAtom(self.display, name.encode("ascii"), False)
+
+    def claim(self, selection, window):
+        atom = self.atom(selection)
+        self.lib.XSetSelectionOwner(self.display, atom, window, 0)
+        assert self.lib.XGetSelectionOwner(self.display, atom) == window
+
+    def events(self, *_args):
+        while self.lib.XPending(self.display):
+            event = XEvent()
+            self.lib.XNextEvent(self.display, C.byref(event))
+            if event.type == 30:
+                request = SelectionRequest.from_buffer_copy(event)
+                self.requests.append(request)
+                if self.mode == "refuse":
+                    self.notify(request)
+                elif self.mode == "success":
+                    self.success(request)
+                elif self.mode == "incr":
+                    self.incremental(request)
+            elif event.type == 28 and event.property.state == 1:
+                key = (event.property.window, event.property.atom)
+                self.property_deletes.append(key)
+                if key in self.incr:
+                    self.incr_deletes.append(key)
+                    if not self.pause_incr:
+                        self.send_chunk(self.incr[key][0])
+        return True
+
+    def write(self, request, dtype, dformat, data, count):
+        self.lib.XChangeProperty(self.display, request.requestor, request.property,
+                                 dtype, dformat, 0, data, count)
+        self.lib.XFlush(self.display)
+
+    def notify(self, request, **overrides):
+        event = XEvent()
+        event.selection.type = 31
+        event.selection.display = self.display
+        for name in ("requestor", "selection", "target", "time"):
+            setattr(event.selection, name, overrides.get(name, getattr(request, name)))
+        event.selection.property = overrides.get("property", 0)
+        assert self.lib.XSendEvent(self.display, event.selection.requestor, False, 0, C.byref(event))
+        self.lib.XFlush(self.display)
+
+    def success(self, request):
+        if request.target == self.atom("TARGETS"):
+            values = (XID * 2)(self.atom("UTF8_STRING"), self.atom("text/plain;charset=utf-8"))
+            self.write(request, self.atom("ATOM"), 32, values, 2)
+        else:
+            self.write(request, request.target, 8, self.data, len(self.data))
+        self.notify(request, property=request.property)
+
+    def send_chunk(self, request):
+        key = (request.requestor, request.property)
+        _request, chunks = self.incr[key]
+        chunk = chunks.pop(0)
+        self.write(request, request.target, 8, chunk, len(chunk))
+        if not chunks:
+            del self.incr[key]
+
+    def incremental(self, request, data=None, size=None):
+        if data is None:
+            data = self.data
+        self.lib.XSelectInput(self.display, request.requestor, 1 << 22)
+        header = (XID * 1)(len(data) if size is None else size)
+        self.incr[(request.requestor, request.property)] = (request, [data[:5], data[5:], b""])
+        self.write(request, self.atom("INCR"), 32, header, 1)
+        self.notify(request, property=request.property)
+
+    def close(self):
+        GLib.source_remove(self.watch)
+        self.lib.XDestroyWindow(self.display, self.window)
+        self.lib.XSync(self.display, False)
+        self.lib.XSetErrorHandler(self.previous_handler)
+        self.lib.XCloseDisplay(self.display)
+
+
+class NativeSelectionRefusalTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        if RAW_NATIVE:
+            from xpra.scripts.main import no_gi_gtk_modules
+            from xpra.x11.bindings.display_source import init_display_source
+            from xpra.x11.bindings.loop import register_glib_source
+            init_display_source()
+            register_glib_source(GLib.MainContext.default())
+            no_gi_gtk_modules()
+            return
+        cls.display = DisplayContext()
+        cls.display.__enter__()
+        cls.addClassCleanup(cls.display.__exit__, None, None, None)
+        from xpra.x11.gtk import bindings
+        # A non-raising call holds a reference even when the filter exists.
+        bindings.init_x11_filter()
+        cls.addClassCleanup(bindings.cleanup_x11_filter)
+
+    @classmethod
+    def tearDownClass(cls):
+        if RAW_NATIVE:
+            assert "xpra.x11.gtk" not in sys.modules, "raw conversion imported GTK"
+
+    def setUp(self):
+        from xpra.x11.selection import proxy
+        from xpra.x11.selection.clipboard import X11Clipboard
+        self.module = proxy
+        self.owner = Owner()
+        self.addCleanup(lambda: self.assertFalse(self.owner.errors))
+        self.addCleanup(self.owner.close)
+        # The real helper owns the legacy PropertyNotify route too. Without
+        # it a clean positive control would fail for an unrelated missing
+        # receiver, obscuring the actual SelectionNotify refusal boundary.
+        self.helper = X11Clipboard(lambda *_packet: None, **{
+            "can-send": True, "can-receive": False,
+            "clipboards.local": ("CLIPBOARD", "PRIMARY"),
+            "clipboards.remote": ("CLIPBOARD", "PRIMARY"),
+        })
+        self.addCleanup(self.cleanup_helper)
+        self.xid = self.helper.event_window_xid
+        self.proxies = {name: self.helper._get_proxy(name) for name in ("CLIPBOARD", "PRIMARY")}
+        self.helper.enable_selections(tuple(self.proxies))
+        self.logging = patch.object(proxy, "log", wraps=proxy.log)
+        self.logger = self.logging.start()
+        self.addCleanup(self.logging.stop)
+
+    def cleanup_helper(self):
+        self.owner.mode = "hold"
+        self.owner.incr.clear()
+        try:
+            self.helper.cleanup()
+        finally:
+            for proxy in getattr(self, "proxies", {}).values():
+                try:
+                    proxy.cancel_incr_data_timer()
+                finally:
+                    proxy.reset_incr_data()
+            spin_until(lambda: False, 0.12)
+
+    def request(self, selection="CLIPBOARD", target="UTF8_STRING"):
+        result = []
+        self.proxies[selection].get_contents(target, lambda *args: result.append(args))
+        return result
+
+    def wait(self, predicate):
+        self.assertTrue(spin_until(predicate), "native X11 transaction did not finish")
+
+    def assert_drained(self):
+        from xpra.x11.dispatch import event_receivers_map
+        for proxy in self.proxies.values():
+            self.assertFalse(proxy.local_requests)
+            for name in ("_requestor_windows", "_requestor_xids", "_requestor_notified", "_requestor_incr"):
+                self.assertFalse(getattr(proxy, name, {}), name)
+        for request in self.owner.requests:
+            if request.requestor != self.xid:
+                self.assertNotIn(request.requestor, event_receivers_map)
+
+    def test_refused_aliases_and_targets_complete_without_timeout(self):
+        self.owner.mode = "refuse"
+        for selection in self.proxies:
+            for target in ("text/plain;charset=utf-8", "text/plain;charset=UTF-8", "TARGETS"):
+                with self.subTest(selection=selection, target=target):
+                    result = self.request(selection, target)
+                    self.wait(lambda: bool(result))
+                    self.assertEqual(result, [("ATOM", 32, b"")] if target == "TARGETS" else [("", 0, b"")])
+                    self.logger.warn.assert_not_called()
+        self.assertEqual(len(self.owner.requests), 6)
+        self.assert_drained()
+
+    def test_no_owner_is_a_server_refusal(self):
+        with patch.object(self.module, "get_wininfo", wraps=self.module.get_wininfo) as owner_info:
+            for selection in self.proxies:
+                self.owner.claim(selection, 0)
+                result = self.request(selection)
+                self.wait(lambda: bool(result))
+                self.assertEqual(result, [("", 0, b"")])
+            for call in owner_info.call_args_list:
+                self.assertNotEqual(call.args[0], 0, "the absent owner is not a queryable window")
+        self.assertFalse(self.owner.requests)
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_positive_targets_text_and_incremental_transfer(self):
+        for selection in self.proxies:
+            for mode, target in (("success", "TARGETS"), ("success", "UTF8_STRING"), ("incr", "TEXT")):
+                with self.subTest(selection=selection, mode=mode):
+                    self.owner.mode = mode
+                    result = self.request(selection, target)
+                    self.wait(lambda: bool(result))
+                    self.assertEqual(len(result), 1)
+                    if target == "TARGETS":
+                        from xpra.x11.selection.common import xatoms_to_strings
+                        self.assertEqual(result[0][:2], ("ATOM", 32))
+                        self.assertEqual(xatoms_to_strings(result[0][2]), ("UTF8_STRING", "text/plain;charset=utf-8"))
+                    else:
+                        self.assertEqual(bytes(result[0][2]), self.owner.data)
+                    if mode == "incr":
+                        request = self.owner.requests[-1]
+                        key = (request.requestor, request.property)
+                        self.wait(lambda: self.owner.property_deletes.count(key) == 4)
+        self.assertFalse(self.owner.incr)
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_identical_conversions_have_independent_negative_and_positive_replies(self):
+        first = self.request()
+        second = self.request()
+        self.wait(lambda: len(self.owner.requests) == 2)
+        old, new = self.owner.requests
+        self.owner.notify(old)
+        self.wait(lambda: bool(first))
+        self.assertEqual(first, [("", 0, b"")])
+        self.assertFalse(second)
+        self.owner.success(new)
+        self.wait(lambda: bool(second))
+        self.assertEqual(bytes(second[0][2]), self.owner.data)
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_duplicate_refusal_cannot_replace_an_accepted_incremental_reply(self):
+        result = self.request()
+        self.wait(lambda: bool(self.owner.requests))
+        request = self.owner.requests[0]
+        self.owner.incremental(request)
+        self.owner.notify(request)
+        self.wait(lambda: bool(result))
+        self.assertEqual(len(result), 1)
+        self.assertEqual(bytes(result[0][2]), self.owner.data)
+        self.assertFalse(self.owner.incr)
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_parallel_incremental_conversions_keep_their_own_bytes(self):
+        for target in ("UTF8_STRING", "TEXT"):
+            with self.subTest(target=target), patch.object(self.module, "CONVERT_TIMEOUT", 2000):
+                before = len(self.owner.requests)
+                first = self.request(target="UTF8_STRING")
+                second = self.request(target=target)
+                self.wait(lambda: len(self.owner.requests) == before + 2)
+                old, new = self.owner.requests[-2:]
+                self.owner.incremental(old, b"first incremental payload")
+                self.owner.incremental(new, b"second independent payload")
+                self.wait(lambda: bool(first) and bool(second))
+                self.assertEqual([bytes(row[2]) for row in first], [b"first incremental payload"])
+                self.assertEqual([bytes(row[2]) for row in second], [b"second independent payload"])
+                self.assert_drained()
+        self.assertFalse(self.owner.incr)
+        self.logger.warn.assert_not_called()
+
+    def test_ordinary_reply_does_not_join_an_incremental_transfer(self):
+        with patch.object(self.module, "CONVERT_TIMEOUT", 2000):
+            first = self.request(target="TEXT")
+            self.wait(lambda: bool(self.owner.requests))
+            incremental = self.owner.requests[0]
+            self.owner.pause_incr = True
+            self.owner.incremental(incremental, b"long independent text")
+            self.wait(lambda: bool(self.owner.incr_deletes))
+            second = self.request()
+            self.wait(lambda: len(self.owner.requests) == 2)
+            self.owner.success(self.owner.requests[1])
+            self.wait(lambda: bool(second))
+            self.assertEqual([bytes(row[2]) for row in second], [self.owner.data])
+            self.assertFalse(first)
+            self.owner.pause_incr = False
+            self.owner.send_chunk(incremental)
+            self.wait(lambda: bool(first))
+            self.assertEqual([bytes(row[2]) for row in first], [b"long independent text"])
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_partial_incremental_timeout_cannot_contaminate_a_retry(self):
+        first = self.request()
+        self.wait(lambda: bool(self.owner.requests))
+        old = self.owner.requests[0]
+        self.owner.pause_incr = True
+        self.owner.incremental(old, b"old partial value")
+        self.wait(lambda: bool(self.owner.incr_deletes))
+        self.owner.send_chunk(old)
+        self.wait(lambda: len(self.owner.incr_deletes) == 2)
+        self.wait(lambda: bool(first))
+        self.assertEqual(first, [("", 0, b"")])
+        self.assertEqual(self.logger.warn.call_count, 2)
+        self.owner.incr.clear()
+        self.logger.warn.reset_mock()
+        self.owner.pause_incr = False
+        self.owner.mode = "success"
+        second = self.request()
+        self.wait(lambda: bool(second))
+        self.assertEqual([bytes(row[2]) for row in second], [self.owner.data])
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_incremental_deadline_retires_only_its_request(self):
+        with patch.object(self.module, "CONVERT_TIMEOUT", 3000):
+            result = self.request()
+        self.wait(lambda: bool(self.owner.requests))
+        self.owner.pause_incr = True
+        self.owner.incremental(self.owner.requests[0])
+        self.wait(lambda: bool(self.owner.incr_deletes))
+        self.assertTrue(spin_until(lambda: bool(result), 2))
+        self.assertEqual(result, [("", 0, b"")])
+        self.logger.warn.assert_called_once_with("Warning: incremental data timeout")
+        self.owner.incr.clear()
+        self.assert_drained()
+
+    def test_zero_lower_bound_incremental_header_still_transfers(self):
+        result = self.request()
+        self.wait(lambda: bool(self.owner.requests))
+        self.owner.incremental(self.owner.requests[0], size=0)
+        self.wait(lambda: bool(result))
+        self.assertEqual([bytes(row[2]) for row in result], [self.owner.data])
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_incremental_limit_and_format_failure_retire_the_request(self):
+        for failure in ("size", "format"):
+            with self.subTest(failure=failure):
+                before = len(self.owner.requests)
+                result = self.request()
+                self.wait(lambda: len(self.owner.requests) == before + 1)
+                request = self.owner.requests[-1]
+                self.owner.pause_incr = True
+                self.owner.incremental(request, b"test payload")
+                deletes = len(self.owner.incr_deletes)
+                self.wait(lambda: len(self.owner.incr_deletes) > deletes)
+                if failure == "size":
+                    with patch.object(self.module, "MAX_DATA_SIZE", 8):
+                        self.owner.write(request, request.target, 8, b"123456", 6)
+                        deletes = len(self.owner.incr_deletes)
+                        self.wait(lambda: len(self.owner.incr_deletes) > deletes)
+                        self.owner.write(request, request.target, 8, b"789", 3)
+                        self.wait(lambda: bool(result))
+                else:
+                    self.owner.send_chunk(request)
+                    deletes = len(self.owner.incr_deletes)
+                    self.wait(lambda: len(self.owner.incr_deletes) > deletes)
+                    values = (C.c_ushort * 1)(65)
+                    self.owner.write(request, request.target, 16, values, 1)
+                    self.wait(lambda: bool(result))
+                self.assertEqual(result, [("", 0, b"")])
+                self.owner.incr.clear()
+                self.assert_drained()
+        self.logger.warn.assert_not_called()
+
+    def test_failed_timer_removal_does_not_skip_other_requestors(self):
+        recorded = []
+        timeout_add = GLib.timeout_add
+        remove = GLib.source_remove
+
+        def schedule(delay, callback, *args):
+            timer = timeout_add(delay, callback, *args)
+            recorded.append((timer, callback, args))
+            return timer
+
+        with patch.object(GLib, "timeout_add", side_effect=schedule):
+            first = self.request()
+            second = self.request(target="TEXT")
+            self.wait(lambda: len(self.owner.requests) == 2)
+            self.owner.pause_incr = True
+            self.owner.incremental(self.owner.requests[0])
+            self.wait(lambda: bool(self.owner.incr_deletes))
+
+        def remove_then_fail(timer):
+            remove(timer)
+            raise RuntimeError("injected removal failure after cancellation")
+
+        with patch.object(GLib, "source_remove", side_effect=remove_then_fail):
+            self.proxies["CLIPBOARD"].cleanup()
+        context = GLib.MainContext.default()
+        self.assertTrue(all(context.find_source_by_id(row[0]) is None for row in recorded))
+        self.owner.incr.clear()
+        for _timer, callback, args in recorded:
+            callback(*args)
+        self.assertFalse(first)
+        self.assertFalse(second)
+        self.logger.warn.assert_not_called()
+        self.assert_drained()
+
+    def test_superseded_incremental_timer_cannot_retire_the_active_request(self):
+        recorded = []
+        timeout_add = GLib.timeout_add
+
+        def schedule(delay, callback, *args):
+            timer = timeout_add(delay, callback, *args)
+            if delay == 1000:
+                recorded.append((callback, args))
+            return timer
+
+        with patch.object(GLib, "timeout_add", side_effect=schedule):
+            result = self.request()
+            self.wait(lambda: bool(self.owner.requests))
+            request = self.owner.requests[0]
+            self.owner.pause_incr = True
+            self.owner.incremental(request)
+            self.wait(lambda: bool(self.owner.incr_deletes))
+            self.owner.send_chunk(request)
+            self.wait(lambda: len(self.owner.incr_deletes) == 2)
+            self.assertGreaterEqual(len(recorded), 2)
+            callback, args = recorded[0]
+            self.assertFalse(callback(*args))
