+    def test_cleanup_finishes_after_timer_removal_failure_and_closes_admission(self):
+        # The isolated loader restores sys.modules: a fresh import may return
+        # another class object, not the parent retained in this class's MRO.
+        parent = WaylandWindowServer.__mro__[1]
+
+        owner = Mock()
+        owner.timeout_add.return_value = 101
+        server = WaylandWindowServer(owner)
+        window = Mock()
+        window.has_wayland_damage_frame_pending.return_value = False
+        server._id_to_window[7] = window
+        server._window_to_id[window] = 7
+        with patch.object(WaylandWindowServer, "has_empty_damage_consumer", return_value=True):
+            server.schedule_empty_damage_ack(7, window)
+        old_callback = owner.timeout_add.call_args.args[1]
+        owner.source_remove.side_effect = RuntimeError("timer removal failed")
+        with patch.object(parent, "cleanup") as parent_cleanup:
+            WaylandWindowServer.cleanup(server)
+        parent_cleanup.assert_called_once_with()
+        self.assertEqual(server._empty_damage_ack_timer, 0)
+        self.assertIsNone(server._empty_damage_ack_owner)
+        self.assertEqual(server._empty_damage_ack_windows, {})
+        self.assertFalse(old_callback())
+        server.schedule_empty_damage_ack(7, window)
+        owner.timeout_add.assert_called_once()
+        window.acknowledge_changes.assert_not_called()
