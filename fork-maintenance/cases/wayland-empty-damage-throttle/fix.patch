@@ -266,2 +281,48 @@ class WaylandWindowServer(WindowServer):
 
+    def schedule_empty_damage_ack(self, wid: int, window: Window) -> None:
+        if (
+            window.has_wayland_damage_frame_pending()
+            or not self.has_empty_damage_consumer(wid, window)
+        ):
+            self.cancel_empty_damage_ack(wid)
+            return
+        self._empty_damage_ack_windows[wid] = window
+        if not self._empty_damage_ack_timer:
+            self._empty_damage_ack_timer = self.timeout_add(
+                EMPTY_DAMAGE_FRAME_DELAY,
+                self.acknowledge_empty_damage,
+            )
+
+    def has_empty_damage_consumer(self, wid: int, window: Window) -> bool:
+        for ss in self.window_sources():
+            if ss.is_closed() or ss.suspended or not ss.can_send_window(window):
+                continue
+            ws = ss.get_window_source(wid)
+            if ws is None or not ws.suspended:
+                return True
+        return False
+
+    def acknowledge_empty_damage(self) -> bool:
+        self._empty_damage_ack_timer = 0
+        windows = tuple(self._empty_damage_ack_windows.items())
+        self._empty_damage_ack_windows.clear()
+        for wid, window in windows:
+            if (
+                self.get_window(wid) is window
+                and self.has_empty_damage_consumer(wid, window)
+            ):
+                window.acknowledge_empty_changes()
+        return False
+
+    def cancel_empty_damage_ack(self, wid: int) -> None:
+        self._empty_damage_ack_windows.pop(wid, None)
+        if not self._empty_damage_ack_windows:
+            self.cancel_empty_damage_acks()
+
+    def cancel_empty_damage_acks(self) -> None:
+        self._empty_damage_ack_windows.clear()
+        if self._empty_damage_ack_timer:
+            self.source_remove(self._empty_damage_ack_timer)
+            self._empty_damage_ack_timer = 0
+
     def subsurface_image(self, wid: int, image: ImageWrapper,
