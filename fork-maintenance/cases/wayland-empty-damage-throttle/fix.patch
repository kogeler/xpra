+    def test_repeated_empty_damage_is_coalesced_without_recursive_acknowledgement(self):
+        window = Mock()
+        server = self.make_server(window)
+
+        def commit_again():
+            if window.acknowledge_changes.call_count < 5:
+                WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+
+        window.acknowledge_changes.side_effect = commit_again
+        for _ in range(100):
+            WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+
+        window.acknowledge_changes.assert_not_called()
+        server.timeout_add.assert_called_once()
+        self.assertFalse(self.fire_empty_damage_timer(server))
+        window.acknowledge_changes.assert_called_once_with()
+        self.assertEqual(server.timeout_add.call_count, 2)
+
+    def test_damage_cancels_pending_empty_acknowledgement(self):
+        window = Mock()
+        server = self.make_server(window)
+
+        WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+        WaylandWindowServer.commit(server, 7, True, (100, 80), ((1, 2, 3, 4),), [])
+
+        server.source_remove.assert_called_once_with(101)
+        self.assertEqual(server._empty_damage_ack_timer, 0)
+        self.assertEqual(server._empty_damage_ack_windows, {})
+        window.acknowledge_changes.assert_not_called()
+        server.refresh_window_area.assert_called_once_with(
+            window, 1, 2, 3, 4, options={"damage": True, "more": False},
+        )
+
+    def test_unmap_one_window_preserves_other_pending_acknowledgement(self):
+        first = Mock()
+        second = Mock()
+        server = self.make_server(first)
+        server.get_window.side_effect = {7: first, 8: second}.get
+
+        WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+        WaylandWindowServer.commit(server, 8, True, (100, 80), (), [])
+        WaylandWindowServer.unmap(server, 7)
+
+        server.source_remove.assert_not_called()
+        self.assertEqual(server._empty_damage_ack_windows, {8: second})
+        self.assertFalse(self.fire_empty_damage_timer(server))
+        first.acknowledge_changes.assert_not_called()
+        second.acknowledge_changes.assert_called_once_with()
+
+    def test_unmap_last_window_removes_the_pending_timer(self):
+        window = Mock()
