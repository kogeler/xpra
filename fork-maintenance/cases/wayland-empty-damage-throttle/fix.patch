+class WaylandWindowServerEmptyDamageTest(unittest.TestCase):
+
+    @staticmethod
+    def configure_window_frame_state(window):
+        damage_frame_pending = {"value": False}
+        window.mark_wayland_damage_frame_pending.side_effect = (
+            lambda: damage_frame_pending.__setitem__("value", True)
+        )
+        window.clear_wayland_damage_frame_pending.side_effect = (
+            lambda: damage_frame_pending.__setitem__("value", False)
+        )
+        window.has_wayland_damage_frame_pending.side_effect = (
+            lambda: damage_frame_pending["value"]
+        )
+
+        def acknowledge_empty_changes():
+            if damage_frame_pending["value"]:
+                return False
+            window.acknowledge_changes()
+            return True
+
+        window.acknowledge_empty_changes.side_effect = acknowledge_empty_changes
+
+    @staticmethod
+    def make_server(window):
+        server = Mock()
+        server.get_window.return_value = window
+        server.get_surface.return_value = Mock()
+        server.subsurface_info = {}
+        server.subsurface_facades = {}
+        server._direct_subsurface_children.return_value = ()
+        source = Mock()
+        source.is_closed.return_value = False
+        source.suspended = False
+        source.can_send_window.return_value = True
+        source.is_window_hidden.return_value = False
+        source.get_window_source.return_value = None
+        source.subsurface_sources = {}
+        server.window_sources.return_value = (source,)
+        server._empty_damage_ack_timer = 0
+        server._empty_damage_ack_owner = None
+        server._empty_damage_ack_closed = False
+        server._empty_damage_ack_windows = {}
+        server.timeout_add.return_value = 101
+        if window is not None:
+            WaylandWindowServerEmptyDamageTest.configure_window_frame_state(window)
+        for name in (
+                "schedule_empty_damage_ack",
+                "has_empty_damage_consumer",
+                "acknowledge_empty_damage",
+                "cancel_empty_damage_ack",
+                "cancel_empty_damage_acks",
+        ):
+            method = getattr(WaylandWindowServer, name, None)
+            if method:
+                getattr(server, name).side_effect = lambda *args, method=method: method(server, *args)
+        return server
+
+    @staticmethod
+    def fire_empty_damage_timer(server):
+        callback = server.timeout_add.call_args.args[1]
+        return callback()
+
+    def test_empty_damage_requires_an_active_window_consumer(self):
+        window = Mock()
+
+        for condition in (
+                "no-sources", "closed", "suspended", "filtered", "hidden",
+                "window-source-suspended",
+        ):
+            with self.subTest(condition=condition):
+                server = self.make_server(window)
+                source = server.window_sources.return_value[0]
+                if condition == "no-sources":
+                    server.window_sources.return_value = ()
+                elif condition == "closed":
+                    source.is_closed.return_value = True
+                elif condition == "suspended":
+                    source.suspended = True
+                elif condition == "filtered":
+                    source.can_send_window.return_value = False
+                elif condition == "hidden":
+                    source.is_window_hidden.return_value = True
+                else:
+                    window_source = Mock()
+                    window_source.suspended = True
+                    source.get_window_source.return_value = window_source
+
+                WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+
+                window.acknowledge_changes.assert_not_called()
+                server.timeout_add.assert_not_called()
+                self.assertEqual(server._empty_damage_ack_windows, {})
+                window.reset_mock()
+
+    def test_consumer_disappears_before_empty_damage_timer(self):
+        window = Mock()
+        server = self.make_server(window)
+
+        WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+        server.window_sources.return_value = ()
+
+        self.assertFalse(self.fire_empty_damage_timer(server))
+        window.acknowledge_changes.assert_not_called()
+        self.assertEqual(server._empty_damage_ack_timer, 0)
+        self.assertEqual(server._empty_damage_ack_windows, {})
+
+    def test_consumer_becomes_hidden_before_empty_damage_timer(self):
