+class WaylandWindowModelTest(unittest.TestCase):
+
+    @staticmethod
+    def make_window():
+        surface = Mock()
+        display = Mock()
+        Window = WaylandWindowServer.commit.__globals__["Window"]
+        # The module was imported inside the temporary native-surface stubs
+        # above. Avoid re-importing PyGObject after patch.dict restored
+        # sys.modules, and avoid property notifications in this isolated model
+        # test while still exercising the real Window implementation.
+        window = Window({})
+        window._gproperties.update({"surface": surface, "display": display})
+        window.setup()
+        return window, surface, display
+
+    def test_damage_guard_is_cleared_before_normal_frame_acknowledgement(self):
+        window, surface, display = self.make_window()
+        events = []
+        surface.frame_done.side_effect = (
+            lambda: events.append(("frame-done", window.has_wayland_damage_frame_pending()))
+        )
+        display.flush_clients.side_effect = lambda: events.append(("flush", None))
+        window.mark_wayland_damage_frame_pending()
+
+        window.acknowledge_changes()
+
+        self.assertFalse(window.has_wayland_damage_frame_pending())
+        self.assertEqual(events, [("frame-done", False), ("flush", None)])
+
+    def test_queue_frame_done_does_not_flush_before_compositor_dispatch(self):
+        window, surface, display = self.make_window()
+        window.mark_wayland_damage_frame_pending()
+
+        self.assertTrue(window.queue_frame_done())
+
+        self.assertFalse(window.has_wayland_damage_frame_pending())
+        surface.frame_done.assert_called_once_with()
+        display.flush_clients.assert_not_called()
+
+    def test_empty_acknowledgement_cannot_bypass_pending_damage(self):
+        window, surface, display = self.make_window()
+        window.mark_wayland_damage_frame_pending()
+
+        self.assertFalse(window.acknowledge_empty_changes())
+        self.assertTrue(window.has_wayland_damage_frame_pending())
+        surface.frame_done.assert_not_called()
+        display.flush_clients.assert_not_called()
+
+        window.clear_wayland_damage_frame_pending()
+        self.assertTrue(window.acknowledge_empty_changes())
+        surface.frame_done.assert_called_once_with()
+        display.flush_clients.assert_called_once_with()
+
+
