+    def test_empty_damage_requires_an_active_window_consumer(self):
+        window = Mock()
+
+        for condition in (
+                "no-sources", "closed", "suspended", "filtered", "window-source-suspended",
+        ):
+            with self.subTest(condition=condition):
+                server = self.make_server(window)
+                source = server.window_sources.return_value[0]
+                if condition == "no-sources":
+                    server.window_sources.return_value = ()
+                elif condition == "closed":
+                    source.is_closed.return_value = True
+                elif condition == "suspended":
+                    source.suspended = True
+                elif condition == "filtered":
+                    source.can_send_window.return_value = False
+                else:
+                    window_source = Mock()
+                    window_source.suspended = True
+                    source.get_window_source.return_value = window_source
+
+                WaylandWindowServer.commit(server, 7, True, (100, 80), (), [])
+
+                window.acknowledge_changes.assert_not_called()
+                server.timeout_add.assert_not_called()
+                self.assertEqual(server._empty_damage_ack_windows, {})
+                window.reset_mock()
