+    def test_subsurface_cleanup_clears_accounting_after_error(self) -> None:
+        connection = self.make_connection()
+        parent = _FakePixelSource(0x10)
+        child = _FakePixelSource(0x20, 0x10)
+        child.offset_x = 3
+        child.offset_y = 4
