+            (2.0, 0.0, 0.5, 0.0, 2.0, 0.5),
+        )
+        affine = wayland_sampling_affine(0, (0.25, 0.5, 2.5, 1.5), 2, 3)
+        self.assertEqual(affine, (1.25, 0.0, 0.375, 0.0, 0.5, 0.25))
