+def _options(value: Any) -> str:
+    if type(value) is not str:
+        raise RMLVOError("options must be a string")
+    if len(value) > MAX_OPTIONS_SIZE:
+        raise RMLVOError("options are too long")
+    if len(value.encode("utf-8")) > MAX_OPTIONS_SIZE:
+        raise RMLVOError("options are too long")
