+                failed = True
+                raise RuntimeError("transient install failure")
+            return install_keymap(candidate, *args, **kwargs)
+
+        manager.device.install_keymap = fail_new_map_once
+        server.sources = [fallback]
+        manager.cleanup_protocol(object())
