+from xpra.net.common import BACKWARDS_COMPATIBLE, Packet
+from xpra.util.objects import typedict
+from xpra.wayland.server.keyboard_config import KeyboardConfig
+from xpra.wayland.server.subsystem.keyboard import (
+    MAX_TRACKED_KEYS,
+    MAX_TRACKED_KEYS_PER_SOURCE,
+    WaylandKeyboardManager,
+)
+from xpra.wayland.server.subsystem.pointer import WaylandPointerManager
+
+Q = ord("q")
+A = ord("a")
+UPPER_Q = ord("Q")
+UPPER_A = ord("A")
+AT = ord("@")
+CYRILLIC_SHORT_I = 0x6CA
+SHIFT_L = 0xFFE1
+CAPS_LOCK = 0xFFE5
+CONTROL_L = 0xFFE3
+NUM_LOCK = 0xFF7F
+SUPER_L = 0xFFEB
+LEVEL5_SHIFT = 0xFE11
