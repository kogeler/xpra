+        self.assertEqual(us.resolve_keycode("Q", 0, ("shift",)), 24)
+        self.assertEqual(us.resolve_keycode("A", 0, ("lock",)), 38)
+        self.assertGreater(us.resolve_keycode("KP_1", 0, ("mod2",)), 0)
+        self.assertGreater(us.resolve_keycode("dead_acute", 0), 0)
