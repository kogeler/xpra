+class FakeCompositor:
+    def __init__(self):
+        self.flushes = 0
+        self.keyboard_device = FakeDevice()
+
+    def get_keyboard_device(self):
+        return self.keyboard_device
+
+    def flush(self):
+        self.flushes += 1
+
