+class EncodeWorker:
+
+    def __init__(self) -> None:
+        self.queue: Queue = Queue()
+        self.optional: list[bool] = []
+        self.callbacks: list = []
+        self.errors: list[BaseException] = []
+        self.thread = Thread(target=self.run, name="test-encode", daemon=True)
+        self.thread.start()
+
+    def call(self, optional: bool, callback, *args) -> None:
+        self.optional.append(optional)
+        self.callbacks.append(callback)
+        self.queue.put((callback, args))
+
+    def run(self) -> None:
+        while True:
+            item = self.queue.get()
+            try:
+                if item is None:
+                    return
+                callback, args = item
+                callback(*args)
+            except BaseException as e:
+                self.errors.append(e)
+            finally:
+                self.queue.task_done()
+
+    def drain(self) -> None:
+        self.queue.join()
+
+    def close(self) -> None:
+        self.queue.put(None)
+        self.queue.join()
+        self.thread.join(2)
+        if self.thread.is_alive():
+            raise RuntimeError("encode worker did not stop")
+
