diff --git a/xpra/wayland/server/clipboard_token.py b/xpra/wayland/server/clipboard_token.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e47d23124bc812f530070354c85e77c09be28b2
--- /dev/null
+++ b/xpra/wayland/server/clipboard_token.py
@@ -0,0 +1,122 @@
+# This file is part of Xpra.
+# Copyright (C) 2026 kogeler
+# Xpra is released under the terms of the GNU GPL v2, or, at your option, any
+# later version. See the file COPYING for details.
+
+"""Per-selection admission of ready native Wayland owner notifications."""
+
+from time import monotonic
+
+from xpra.os_util import gi_import
+from xpra.util.env import envint
+from xpra.log import Logger
+
+GLib = gi_import("GLib")
+log = Logger("wayland", "clipboard")
+
+# Use X11's policy settings, without depending on X11 bindings or its display.
+TOKEN_BACKOFF_RESET = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_RESET", 1000)
+TOKEN_BACKOFF_DELAY = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_DELAY", 20)
+TOKEN_BACKOFF_MAX = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_MAX", 1000)
+
+
+class WaylandTokenMixin:
+    """Keep native readiness and cancellation out of the generic scheduler.
+
+    Native proxy constructors initialize ClipboardProxyCore and GObject
+    explicitly, so each also calls init_token_state before registering signals.
+    The transfer-lifecycle adapter may override these methods cooperatively.
+    """
+
+    def init_token_state(self) -> None:
+        self._token_source_generation = 0
+        self._token_ready_source = None
+        self._token_reservation = None
+        self._token_last_attempt = 0.0
+        self._token_backoff = 0
+
+    def token_owner_changed(self) -> None:
+        # A reused native pointer does not make an old origin read current.
+        self._token_source_generation += 1
+        self._token_ready_source = None
+
+    def set_enabled(self, enabled: bool) -> None:
+        super().set_enabled(enabled)
+        if not enabled:
+            self.cancel_emit_token()
+
+    def set_direction(self, can_send: bool, can_receive: bool) -> None:
+        super().set_direction(can_send, can_receive)
+        if not can_send:
+            self.cancel_emit_token()
+
+    def cancel_emit_token(self) -> None:
+        self._token_reservation = None
+        self.token_owner_changed()
+        self._token_last_attempt = 0.0
+        self._token_backoff = 0
+        try:
+            super().cancel_emit_token()
+        except Exception:
+            # Retirement precedes GLib removal. A late closure cannot publish,
+            # and an ordinary removal failure must not skip native teardown.
+            log("failed to remove a Wayland clipboard token timer", exc_info=True)
+
+
+def source_key(proxy) -> tuple[int, int]:
+    return proxy.local_source_ptr, proxy._token_source_generation
+
+
+def defer_owner_change(proxy) -> bool:
+    """Admit now or leave one non-postponed timer owning the latest ready state.
+
+    Like ClipboardProxyCore scheduling, elapsed milliseconds count towards
+    the delay. Native admission additionally needs origin readiness and an
+    exact one-shot reservation; it does not change generic reschedule/cancel
+    semantics or count a deferred attempt as an already published packet.
+    """
+    if (not proxy._enabled or not proxy._can_send
+            or proxy.local_source_ptr in (0, proxy.remote_source_ptr)):
+        return True
+    proxy._token_ready_source = source_key(proxy)
+    if proxy._emit_token_timer:
+        return True
+    now = round(monotonic() * 1000)
+    elapsed = now - round(proxy._token_last_attempt * 1000)
+    if elapsed >= TOKEN_BACKOFF_RESET:
+        proxy._token_backoff = 0
+
+    def record_attempt() -> None:
+        proxy._token_last_attempt = monotonic()
+        scale = (2 if proxy._want_targets else 1) * (2 if proxy._greedy_client else 1)
+        proxy._token_backoff = min(
+            TOKEN_BACKOFF_MAX,
+            proxy._token_backoff * 2 or TOKEN_BACKOFF_DELAY * scale,
+        )
+
+    delay = max(0, proxy._token_backoff - elapsed)
+    if delay == 0:
+        record_attempt()
+        return False
+
+    reservation = object()
+
+    def emit_latest() -> bool:
+        if proxy._token_reservation is not reservation:
+            return False
+        proxy._token_reservation = None
+        proxy._emit_token_timer = 0
+        proxy._emit_token_due = 0
+        if (not proxy._enabled or not proxy._can_send
+                or proxy.local_source_ptr in (0, proxy.remote_source_ptr)
+                or source_key(proxy) != proxy._token_ready_source):
+            return False
