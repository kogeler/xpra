diff --git a/xpra/wayland/server/clipboard_token.py b/xpra/wayland/server/clipboard_token.py
new file mode 100644
index 0000000000000000000000000000000000000000..e107cd61550a21661eaf1fc1bea58a57b4478fee
--- /dev/null
+++ b/xpra/wayland/server/clipboard_token.py
@@ -0,0 +1,70 @@
+# This file is part of Xpra.
+# Copyright (C) 2026 kogeler
+# Xpra is released under the terms of the GNU GPL v2, or, at your option, any
+# later version. See the file COPYING for details.
+
+"""Back off native owner notifications without losing the last selection."""
+
+from time import monotonic
+
+from xpra.os_util import gi_import
+from xpra.util.env import envint
+
+GLib = gi_import("GLib")
+
+# Match the X11 producer; the connection's packet flood limit stays unchanged.
+TOKEN_BACKOFF_RESET = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_RESET", 1000)
+TOKEN_BACKOFF_DELAY = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_DELAY", 20)
+TOKEN_BACKOFF_MAX = envint("XPRA_CLIPBOARD_TOKEN_BACKOFF_MAX", 1000)
+
+
+def source_key(proxy) -> tuple:
+    return proxy.local_source_ptr, getattr(proxy, "local_generation", None)
+
+
+def defer_owner_change(proxy) -> bool:
+    """Return true if this notification is suppressed or owned by a timer.
+
+    This runs only after the native source's origin has been resolved. Updating
+    that ready-source key does not restart an existing timer: continuous native
+    changes must make progress, not debounce indefinitely.
+    """
+    if not proxy._enabled or not proxy._can_send:
+        return True
+    proxy._emit_token_source = source_key(proxy)
+    if proxy._emit_token_timer:
+        return True
+    elapsed = int((monotonic() - proxy._last_emit_token) * 1000)
+    if elapsed >= TOKEN_BACKOFF_RESET:
+        proxy._emit_token_backoff = 0
+
+    def record_emission() -> None:
+        proxy._last_emit_token = monotonic()
+        proxy._sent_token_events += 1
+        scale = (2 if proxy._want_targets else 1) * (2 if proxy._greedy_client else 1)
+        proxy._emit_token_backoff = min(
+            TOKEN_BACKOFF_MAX,
+            proxy._emit_token_backoff * 2 or TOKEN_BACKOFF_DELAY * scale,
+        )
+
+    delay = proxy._emit_token_backoff
+    if delay <= 0:
+        record_emission()
+        return False
+
+    def emit_latest() -> bool:
+        # A removed callback must not clear a newer timer or reach a new peer.
+        if proxy._emit_token_timer != timer:
+            return False
+        proxy._emit_token_timer = 0
+        if (not proxy._enabled or not proxy._can_send
+                or proxy.local_source_ptr in (0, proxy.remote_source_ptr)
+                or source_key(proxy) != proxy._emit_token_source):
+            return False
+        record_emission()
+        proxy.schedule_emit_token()
+        return False
+
+    timer = GLib.timeout_add(delay, emit_latest)
+    proxy._emit_token_timer = timer
+    return True
