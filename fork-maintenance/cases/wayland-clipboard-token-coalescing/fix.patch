--- /dev/null
+++ b/tests/unittests/unit/wayland/clipboard_token_test.py
@@ -0,0 +1,360 @@
+#!/usr/bin/env python3
+# This file is part of Xpra.
+# Copyright (C) 2026 kogeler
+# Xpra is released under the terms of the GNU GPL v2, or, at your option, any
+# later version. See the file COPYING for details.
+
+import os
+import sys
+import unittest
+from time import monotonic, sleep
+from unittest.mock import patch
+
+from xpra.os_util import gi_import
+
+GLib = gi_import("GLib")
+SELECTIONS = ("CLIPBOARD", "PRIMARY")
+ORIGIN = "application/x-xpra-clipboard-origin"
+
+
+def spin_until(predicate, timeout=2) -> bool:
+    context = GLib.MainContext.default()
+    deadline = monotonic() + timeout
+    while monotonic() < deadline:
+        while context.pending() and monotonic() < deadline:
+            context.iteration(False)
+        if predicate():
+            return True
+        sleep(0.005)
+    return predicate()
+
+
+class Compositor:
+    def connect(self, _name, callback):
+        return callback
+
+    def disconnect(self, _name, _callback):
+        pass
+
+    def get_display_ptr(self):
+        return 0
+
+    def get_seat_ptr(self):
+        return 0
+
+
+class SelectionAPI:
+    def __init__(self, proxy):
+        self.proxy = proxy
+        self.reads = []
+        self.eager = False
+        self.origin = False
+        self.hold_text = False
+        self.writers = []
+        self.source = None
+
+    def source_targets(self, source_ptr):
+        targets = ("UTF8_STRING",) if self.eager else (f"application/x-test-{source_ptr}",)
+        return targets + ((ORIGIN,) if self.origin else ())
+
+    def send_source(self, source_ptr, target, fd):
+        self.reads.append((source_ptr, target))
+        if target == ORIGIN or self.hold_text:
+            self.writers.append(os.dup(fd))
+        else:
+            os.write(fd, f"selection-{source_ptr}".encode())
+
+    def clear(self):
+        previous, self.source = self.source, None
+        if previous is not None:
+            previous.destroy()
+        ClipboardTokenTest.change(self.proxy, 0)
+
+    def set_source(self, source):
+        previous, self.source = self.source, source
+        if previous is not None and previous is not source:
+            previous.destroy()
+        ClipboardTokenTest.change(self.proxy, source.ptr())
+
+    def close_writers(self):
+        for fd in self.writers:
+            if fd >= 0:
+                os.close(fd)
+        self.writers.clear()
+
+    def complete(self, index, data):
+        fd, self.writers[index] = self.writers[index], -1
+        try:
+            os.write(fd, data)
+        except BrokenPipeError:
+            # The transfer-owning case closes an obsolete read immediately.
+            # Standalone source keeps the pipe until its callback/cleanup.
+            pass
+        finally:
+            os.close(fd)
+
+
+class ClipboardTokenTest(unittest.TestCase):
+    def make_helper(self):
+        # Missing native extensions are an environment failure, never a skip.
+        from xpra.wayland.server.clipboard import WaylandClipboard
+
+        helper = WaylandClipboard(
+            lambda *_packet: None, compositor=Compositor(),
+            **{"can-send": True, "can-receive": True},
+        )
+        helper.enable_selections(SELECTIONS)
+        events = {selection: [] for selection in SELECTIONS}
+        for selection, proxy in helper._clipboard_proxies.items():
+            proxy.selection_api = SelectionAPI(proxy)
+            self.addCleanup(proxy.selection_api.close_writers)
+            proxy.set_want_targets(True)
+            proxy.connect("send-clipboard-token", lambda _proxy, token, out: out.append(token), events[selection])
+        self.addCleanup(helper.cleanup)
+        return helper, events
+
+    @staticmethod
+    def change(proxy, source_ptr):
+        api = proxy.selection_api
+        if api.source is not None and source_ptr != api.source.ptr():
+            previous, api.source = api.source, None
+            previous.destroy()
+        if proxy._selection == "CLIPBOARD":
+            proxy.selection_changed(source_ptr)
+        else:
+            proxy.primary_selection_changed(source_ptr)
+
+    def test_burst_coalesces_and_delivers_latest_source(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            for source_ptr in range(1, 101):
+                self.change(proxy, 0)
+                self.change(proxy, source_ptr)
+        # A native owner burst must not become a wire packet per keystroke.
+        self.assertEqual([len(events[x]) for x in SELECTIONS], [1, 1])
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+        for selection, proxy in helper._clipboard_proxies.items():
+            self.assertEqual(events[selection][-1]["targets"], ("application/x-test-100",))
+            self.assertEqual(proxy._emit_token_timer, 0)
+            self.assertEqual(proxy._sent_token_events, 2)
+
+    def test_continuous_changes_make_bounded_progress(self):
+        helper, events = self.make_helper()
+        for source_ptr in range(1, 31):
+            for proxy in helper._clipboard_proxies.values():
+                self.change(proxy, 0)
+                self.change(proxy, source_ptr)
+            end = monotonic() + 0.025
+            spin_until(lambda: monotonic() >= end, timeout=0.1)
+        for selection in SELECTIONS:
+            self.assertGreaterEqual(len(events[selection]), 3)
+            self.assertLessEqual(len(events[selection]), 6)
+        self.assertTrue(spin_until(lambda: all(
+            events[x][-1]["targets"] == ("application/x-test-30",) for x in SELECTIONS
+        )))
+
+    def test_cancellation_and_stale_callback_ownership(self):
+        for selection in SELECTIONS:
+            for revoke in ("disable", "direction", "peer", "remote", "cleanup"):
+                with self.subTest(selection=selection, revoke=revoke):
+                    helper, events = self.make_helper()
+                    proxy = helper._clipboard_proxies[selection]
+                    callbacks = []
+
+                    def schedule(_delay, callback):
+                        callbacks.append(callback)
+                        # Force reuse to distinguish reservation identity from
+                        # an equality check on a recycled numeric GLib ID.
+                        return 7
+
+                    with patch.object(GLib, "timeout_add", schedule), patch.object(GLib, "source_remove"):
+                        self.change(proxy, 1)
+                        self.change(proxy, 2)
+                        self.assertEqual(len(callbacks), 1)
+                        if revoke == "disable":
+                            proxy.set_enabled(False)
+                        elif revoke == "direction":
+                            proxy.set_direction(False, True)
+                        elif revoke == "peer":
+                            helper.client_reset()
+                        elif revoke == "remote":
+                            proxy.got_token(("text/plain",), {"text/plain": ("text/plain", 8, b"remote")})
+                        else:
+                            proxy.cleanup()
+                        self.assertEqual(proxy._emit_token_timer, 0)
+                        self.assertFalse(callbacks[0]())
+                        self.assertEqual(len(events[selection]), 1)
+                        if revoke != "cleanup":
+                            proxy.set_enabled(True)
+                            proxy.set_direction(True, True)
+                            self.change(proxy, 3)
+                            self.assertEqual(len(events[selection]), 2)
+                            self.change(proxy, 4)
+                            self.assertEqual(proxy._emit_token_timer, 7)
+                            self.assertFalse(callbacks[0]())
+                            self.assertEqual(proxy._emit_token_timer, 7)
+                            self.assertFalse(callbacks[1]())
+                            self.assertEqual(len(events[selection]), 3)
+
+    def test_receive_revocation_does_not_cancel_outbound_token(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            self.change(proxy, 1)
+            self.change(proxy, 2)
+            timer = proxy._emit_token_timer
+            self.assertNotEqual(timer, 0)
+            proxy.set_direction(True, False)
+            self.assertEqual(proxy._emit_token_timer, timer)
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+
+    def test_elapsed_delay_retains_deadline_and_quiet_period_resets_backoff(self):
+        from xpra.wayland.server import clipboard
+
+        # Clean source has no separate timing helper: instrument its native
+        # module instead, then fail on missing bounded scheduling, not import.
+        timing = sys.modules.get("xpra.wayland.server.clipboard_token", clipboard)
+        for selection in SELECTIONS:
+            with self.subTest(selection=selection):
+                helper, events = self.make_helper()
+                proxy = helper._clipboard_proxies[selection]
+                scheduled = []
+                now = [200.0]
+
+                def schedule(delay, callback):
+                    scheduled.append((delay, callback))
+                    return 7
+
+                with (
+                    patch.object(timing, "monotonic", new=lambda: now[0], create=True),
+                    patch.object(timing, "TOKEN_BACKOFF_DELAY", 20, create=True),
+                    patch.object(timing, "TOKEN_BACKOFF_RESET", 1000, create=True),
+                    patch.object(timing, "TOKEN_BACKOFF_MAX", 1000, create=True),
+                    patch.object(GLib, "timeout_add", new=schedule),
+                    patch.object(GLib, "source_remove"),
+                ):
+                    self.change(proxy, 1)
+                    now[0] = 200.025
+                    self.change(proxy, 2)
+                    self.assertEqual(len(scheduled), 1)
+                    self.assertEqual(scheduled[0][0], 15)
+                    due = proxy._emit_token_due
+                    now[0] = 200.030
+                    self.change(proxy, 3)
+                    self.assertEqual(len(scheduled), 1)
+                    self.assertEqual(proxy._emit_token_due, due)
+                    now[0] = 200.040
+                    scheduled[0][1]()
+                    self.assertEqual(events[selection][-1]["targets"], ("application/x-test-3",))
+                    now[0] = 200.100
+                    self.change(proxy, 4)
+                    self.assertEqual(scheduled[1][0], 20)
+                    now[0] = 200.120
+                    scheduled[1][1]()
+                    now[0] = 202.0
+                    self.change(proxy, 5)
+                    self.assertEqual(len(scheduled), 2)
+                    self.assertEqual(len(events[selection]), 4)
+                    self.assertEqual(proxy._sent_token_events, 4)
+
+    def test_failed_timer_admission_and_removal_do_not_leave_a_live_reservation(self):
+        from xpra.wayland.server import clipboard
+
+        timing = sys.modules.get("xpra.wayland.server.clipboard_token", clipboard)
+        for selection in SELECTIONS:
+            with self.subTest(selection=selection):
+                helper, events = self.make_helper()
+                proxy = helper._clipboard_proxies[selection]
+                callbacks = []
+
+                def schedule(_delay, callback):
+                    callbacks.append(callback)
+                    return 7
+
+                with patch.object(timing, "monotonic", new=lambda: 200.0, create=True):
+                    self.change(proxy, 1)
+                    with patch.object(GLib, "timeout_add", side_effect=RuntimeError("timer admission failed")):
+                        with self.assertRaisesRegex(RuntimeError, "timer admission failed"):
+                            self.change(proxy, 2)
+                    self.assertEqual(proxy._emit_token_timer, 0)
+                    self.assertEqual(proxy._emit_token_due, 0)
+                    self.assertEqual(proxy._sent_token_events, 1)
+                    with patch.object(GLib, "timeout_add", new=schedule):
+                        self.change(proxy, 3)
+                    self.assertEqual(len(callbacks), 1)
+                    with patch.object(GLib, "source_remove", side_effect=RuntimeError("remove failed")):
+                        proxy.set_enabled(False)
+                    self.assertEqual(proxy._emit_token_timer, 0)
+                    self.assertFalse(callbacks[0]())
+                    self.assertEqual(len(events[selection]), 1)
+
+    def test_empty_replacement_is_not_advertised(self):
+        for selection in SELECTIONS:
+            with self.subTest(selection=selection):
+                helper, events = self.make_helper()
+                proxy = helper._clipboard_proxies[selection]
+                self.change(proxy, 1)
+                self.change(proxy, 2)
+                self.assertNotEqual(proxy._emit_token_timer, 0)
+                self.change(proxy, 0)
+                self.assertTrue(spin_until(lambda: proxy._emit_token_timer == 0))
+                self.assertEqual(len(events[selection]), 1)
+                self.change(proxy, 4)
+                self.assertTrue(spin_until(lambda: len(events[selection]) == 2))
+                self.assertEqual(events[selection][-1]["targets"], ("application/x-test-4",))
+
+    def test_origin_pipe_replacement_with_reused_pointer_requires_new_readiness(self):
+        for selection in SELECTIONS:
+            with self.subTest(selection=selection):
+                helper, events = self.make_helper()
+                proxy = helper._clipboard_proxies[selection]
+                api = proxy.selection_api
+                self.change(proxy, 1)
+                self.change(proxy, 2)
+                api.origin = True
+                self.change(proxy, 3)
+                self.change(proxy, 3)
+                self.assertEqual(api.reads, [(3, ORIGIN), (3, ORIGIN)])
+                api.complete(0, b"obsolete-origin")
+                self.assertTrue(spin_until(lambda: proxy._emit_token_timer == 0))
+                self.assertEqual(len(events[selection]), 1)
+                self.assertNotEqual(proxy._clipboard_origin, "obsolete-origin")
+                api.complete(1, b"current-origin")
+                self.assertTrue(spin_until(lambda: len(events[selection]) == 2))
+                self.assertEqual(proxy._clipboard_origin, "current-origin")
+                self.assertEqual(events[selection][-1]["targets"], ("application/x-test-3",))
+
+    def test_cancelled_eager_attempt_is_not_counted_as_a_published_token(self):
+        for selection in SELECTIONS:
+            with self.subTest(selection=selection):
+                helper, events = self.make_helper()
+                proxy = helper._clipboard_proxies[selection]
+                api = proxy.selection_api
+                api.eager = api.hold_text = True
+                proxy.set_greedy_client(True)
+                self.change(proxy, 1)
+                self.assertEqual(api.reads, [(1, "UTF8_STRING")])
+                self.assertEqual(proxy._sent_token_events, 0)
+                proxy.set_direction(False, True)
+                api.complete(0, b"cancelled")
+                self.assertTrue(spin_until(lambda: not proxy.pending_reads))
+                self.assertEqual(events[selection], [])
+                self.assertEqual(proxy._sent_token_events, 0)
+
+    def test_eager_read_uses_latest_source_when_timer_fires(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            self.change(proxy, 1)
+            proxy.selection_api.eager = True
+            proxy.set_greedy_client(True)
+            self.change(proxy, 2)
+            self.change(proxy, 3)
+            self.assertEqual(proxy.selection_api.reads, [])
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+        for selection, proxy in helper._clipboard_proxies.items():
+            self.assertEqual(proxy.selection_api.reads, [(3, "UTF8_STRING")])
+            self.assertEqual(events[selection][-1]["data"]["UTF8_STRING"],
+                             ("UTF8_STRING", 8, b"selection-3"))
+
+
+if __name__ == "__main__":
+    unittest.main()
