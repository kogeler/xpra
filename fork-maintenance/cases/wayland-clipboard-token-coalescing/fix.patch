diff --git a/tests/unittests/unit/wayland/clipboard_token_test.py b/tests/unittests/unit/wayland/clipboard_token_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e25cbb29f370981431f88f3b92a51604196a0ee
--- /dev/null
+++ b/tests/unittests/unit/wayland/clipboard_token_test.py
@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+# This file is part of Xpra.
+# Copyright (C) 2026 kogeler
+# Xpra is released under the terms of the GNU GPL v2, or, at your option, any
+# later version. See the file COPYING for details.
+
+import os
+import unittest
+from time import monotonic, sleep
+from unittest.mock import patch
+
+from xpra.os_util import gi_import
+
+GLib = gi_import("GLib")
+SELECTIONS = ("CLIPBOARD", "PRIMARY")
+
+
+def spin_until(predicate, timeout=2) -> bool:
+    context = GLib.MainContext.default()
+    deadline = monotonic() + timeout
+    while monotonic() < deadline:
+        while context.pending() and monotonic() < deadline:
+            context.iteration(False)
+        if predicate():
+            return True
+        sleep(0.005)
+    return predicate()
+
+
+class Compositor:
+    def connect(self, _name, callback):
+        return callback
+
+    def disconnect(self, _name, _callback):
+        pass
+
+    def get_display_ptr(self):
+        return 0
+
+    def get_seat_ptr(self):
+        return 0
+
+
+class SelectionAPI:
+    def __init__(self):
+        self.reads = []
+        self.eager = False
+
+    def source_targets(self, source_ptr):
+        return ("UTF8_STRING",) if self.eager else (f"application/x-test-{source_ptr}",)
+
+    def send_source(self, source_ptr, target, fd):
+        self.reads.append((source_ptr, target))
+        os.write(fd, f"selection-{source_ptr}".encode())
+
+    def clear(self):
+        pass
+
+    def set_source(self, _source):
+        pass
+
+
+class ClipboardTokenTest(unittest.TestCase):
+    def make_helper(self):
+        # Missing native extensions are an environment failure, never a skip.
+        from xpra.wayland.server.clipboard import WaylandClipboard
+
+        helper = WaylandClipboard(
+            lambda *_packet: None, compositor=Compositor(),
+            **{"can-send": True, "can-receive": True},
+        )
+        helper.enable_selections(SELECTIONS)
+        events = {selection: [] for selection in SELECTIONS}
+        for selection, proxy in helper._clipboard_proxies.items():
+            proxy.selection_api = SelectionAPI()
+            proxy.set_want_targets(True)
+            proxy.connect("send-clipboard-token", lambda _proxy, token, out: out.append(token), events[selection])
+        self.addCleanup(helper.cleanup)
+        return helper, events
+
+    @staticmethod
+    def change(proxy, source_ptr):
+        if proxy._selection == "CLIPBOARD":
+            proxy.selection_changed(source_ptr)
+        else:
+            proxy.primary_selection_changed(source_ptr)
+
+    def test_burst_coalesces_and_delivers_latest_source(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            for source_ptr in range(1, 101):
+                self.change(proxy, 0)
+                self.change(proxy, source_ptr)
+        # A native owner burst must not become a wire packet per keystroke.
+        self.assertEqual([len(events[x]) for x in SELECTIONS], [1, 1])
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+        for selection, proxy in helper._clipboard_proxies.items():
+            self.assertEqual(events[selection][-1]["targets"], ("application/x-test-100",))
+            self.assertEqual(proxy._emit_token_timer, 0)
+            self.assertEqual(proxy._sent_token_events, 2)
+
+    def test_continuous_changes_make_bounded_progress(self):
+        helper, events = self.make_helper()
+        for source_ptr in range(1, 31):
+            for proxy in helper._clipboard_proxies.values():
+                self.change(proxy, 0)
+                self.change(proxy, source_ptr)
+            end = monotonic() + 0.025
+            spin_until(lambda: monotonic() >= end, timeout=0.1)
+        for selection in SELECTIONS:
+            self.assertGreaterEqual(len(events[selection]), 3)
+            self.assertLessEqual(len(events[selection]), 6)
+        self.assertTrue(spin_until(lambda: all(
+            events[x][-1]["targets"] == ("application/x-test-30",) for x in SELECTIONS
+        )))
+
+    def test_cancellation_and_stale_callback_ownership(self):
+        for selection in SELECTIONS:
+            for revoke in ("disable", "direction", "peer", "remote", "cleanup"):
+                with self.subTest(selection=selection, revoke=revoke):
+                    helper, events = self.make_helper()
+                    proxy = helper._clipboard_proxies[selection]
+                    callbacks = []
+
+                    def schedule(_delay, callback):
+                        callbacks.append(callback)
+                        return len(callbacks)
+
+                    with patch.object(GLib, "timeout_add", schedule), patch.object(GLib, "source_remove"):
+                        self.change(proxy, 1)
+                        self.change(proxy, 2)
+                        self.assertEqual(len(callbacks), 1)
+                        if revoke == "disable":
+                            proxy.set_enabled(False)
+                        elif revoke == "direction":
+                            proxy.set_direction(False, True)
+                        elif revoke == "peer":
+                            helper.client_reset()
+                        elif revoke == "remote":
+                            proxy.got_token((), claim=False)
+                        else:
+                            proxy.cleanup()
+                        self.assertEqual(proxy._emit_token_timer, 0)
+                        self.assertFalse(callbacks[0]())
+                        self.assertEqual(len(events[selection]), 1)
+                        if revoke != "cleanup":
+                            proxy.set_enabled(True)
+                            proxy.set_direction(True, True)
+                            self.change(proxy, 3)
+                            self.assertEqual(len(events[selection]), 2)
+                            self.change(proxy, 4)
+                            self.assertEqual(proxy._emit_token_timer, 2)
+                            self.assertFalse(callbacks[0]())
+                            self.assertEqual(proxy._emit_token_timer, 2)
+                            self.assertFalse(callbacks[1]())
+                            self.assertEqual(len(events[selection]), 3)
+
+    def test_receive_revocation_does_not_cancel_outbound_token(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            self.change(proxy, 1)
+            self.change(proxy, 2)
+            timer = proxy._emit_token_timer
+            self.assertNotEqual(timer, 0)
+            proxy.set_direction(True, False)
+            self.assertEqual(proxy._emit_token_timer, timer)
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+
+    def test_empty_or_unresolved_replacement_is_not_advertised(self):
+        for selection in SELECTIONS:
+            for replacement in (0, 3):
+                with self.subTest(selection=selection, replacement=replacement):
+                    helper, events = self.make_helper()
+                    proxy = helper._clipboard_proxies[selection]
+                    self.change(proxy, 1)
+                    self.change(proxy, 2)
+                    self.assertNotEqual(proxy._emit_token_timer, 0)
+                    # A new source may still be waiting for its origin pipe;
+                    # only do_owner_changed marks it ready to advertise.
+                    proxy.local_source_ptr = replacement
+                    self.assertTrue(spin_until(lambda: proxy._emit_token_timer == 0))
+                    self.assertEqual(len(events[selection]), 1)
+                    self.change(proxy, 4)
+                    self.assertTrue(spin_until(lambda: len(events[selection]) == 2))
+                    self.assertEqual(events[selection][-1]["targets"], ("application/x-test-4",))
+
+    def test_eager_read_uses_latest_source_when_timer_fires(self):
+        helper, events = self.make_helper()
+        for proxy in helper._clipboard_proxies.values():
+            self.change(proxy, 1)
+            proxy.selection_api.eager = True
+            proxy.set_greedy_client(True)
+            self.change(proxy, 2)
+            self.change(proxy, 3)
+            self.assertEqual(proxy.selection_api.reads, [])
+        self.assertTrue(spin_until(lambda: all(len(events[x]) == 2 for x in SELECTIONS)))
+        for selection, proxy in helper._clipboard_proxies.items():
+            self.assertEqual(proxy.selection_api.reads, [(3, "UTF8_STRING")])
+            self.assertEqual(events[selection][-1]["data"]["UTF8_STRING"],
+                             ("UTF8_STRING", 8, b"selection-3"))
+
+
+if __name__ == "__main__":
+    unittest.main()
