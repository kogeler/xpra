+class FakeCompositor:
+    def __init__(self):
+        self.event_listeners = {}
+
+    def connect(self, event_name, handler):
+        self.event_listeners.setdefault(event_name, []).append(handler)
+        return handler
+
+    def disconnect(self, event_name, handler):
+        callbacks = self.event_listeners.get(event_name, [])
+        for index, callback in enumerate(callbacks):
+            if callback is handler:
+                callbacks.pop(index)
+                break
+        if not callbacks:
+            self.event_listeners.pop(event_name, None)
+
+    @staticmethod
+    def get_display_ptr() -> int:
+        return 0
+
+    @staticmethod
+    def get_seat_ptr() -> int:
+        return 0
