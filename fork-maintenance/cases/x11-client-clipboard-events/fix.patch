+def spin_until(predicate, timeout=1) -> bool:
+    context = gi_import("GLib").MainContext.default()
+    deadline = monotonic() + timeout
+    while monotonic() < deadline:
+        while context.pending():
+            context.iteration(False)
+        if predicate():
+            return True
+        sleep(0.01)
+    return predicate()
