+class FakeCompositor:
+    def __init__(self):
+        self.event_listeners = {}
+
+    def connect(self, event_name, handler):
+        self.event_listeners.setdefault(event_name, []).append(handler)
+        return handler
+
+    def disconnect(self, event_name, handler):
+        callbacks = self.event_listeners.get(event_name, [])
+        for index, callback in enumerate(callbacks):
+            if callback is handler:
+                callbacks.pop(index)
+                break
+        if not callbacks:
+            self.event_listeners.pop(event_name, None)
+
+    @staticmethod
+    def get_display_ptr() -> int:
+        return 0
+
+    @staticmethod
+    def get_seat_ptr() -> int:
+        return 0
+
+
+class FakeSelectionAPI:
+    def __init__(self, targets=(TARGET,)):
+        self.targets = targets
+        self.write_fds = []
+        self.clear_calls = 0
+        self.set_calls = 0
+
+    def source_targets(self, _source_ptr: int) -> tuple[str, ...]:
+        return self.targets
+
+    def send_source(self, _source_ptr: int, _target: str, fd: int) -> None:
+        self.write_fds.append(os.dup(fd))
+
+    def set_source(self, _source) -> None:
+        self.set_calls += 1
+
+    def clear(self) -> None:
+        self.clear_calls += 1
+
