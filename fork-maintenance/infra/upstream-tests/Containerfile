FROM docker.io/library/ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

# Keep this package set aligned with Xpra's Ubuntu 26.04 unit-test job.
# Git and ccache are runner-only additions used to snapshot and patch the
# read-only repository efficiently.
RUN apt-get update \
    && apt-get -y install \
        binutils \
        build-essential \
        ccache \
        dbus-x11 \
        git \
        gstreamer1.0-alsa \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-pulseaudio \
        gstreamer1.0-vaapi \
        keyboard-configuration \
        libaom-dev \
        libavif-dev \
        libbrotli-dev \
        libdrm-dev \
        libgtk-3-dev \
        liblz4-dev \
        libopenh264-dev \
        libpam-dev \
        libpipewire-0.3-dev \
        libpixman-1-dev \
        libqrencode-dev \
        libseccomp-dev \
        libsystemd-dev \
        libturbojpeg-dev \
        libvpx-dev \
        libwayland-bin \
        libwayland-dev \
        libwebp-dev \
        libwlroots-0.19-dev \
        libx11-dev \
        libx264-dev \
        libxcomposite-dev \
        libxdamage-dev \
        libxkbfile-dev \
        libxkbcommon-dev \
        libxpresent-dev \
        libxres-dev \
        libxtst-dev \
        libxxhash-dev \
        libyuv-dev \
        openssh-client \
        openssl \
        pandoc \
        pkg-config \
        python-gi-dev \
        python3-aioquic \
        python3-cairo \
        python3-cairo-dev \
        python3-coverage \
        python3-cryptography \
        python3-dbus \
        python3-dev \
        python3-gi \
        python3-gi-cairo \
        python3-gssapi \
        python3-gst-1.0 \
        python3-kerberos \
        python3-lz4 \
        python3-netifaces \
        python3-opengl \
        python3-paramiko \
        python3-pil \
        python3-pip \
        python3-scramp \
        python3-setproctitle \
        python3-setuptools \
        python3-wheel \
        python3-xdg \
        sshpass \
        tigervnc-standalone-server \
        tigervnc-viewer \
        wayland-protocols \
        x11-xkb-utils \
        x11-xserver-utils \
        xauth \
        xserver-xorg-dev \
        xserver-xorg-video-dummy \
        xutils-dev \
        xvfb \
    && python3 -m pip install --break-system-packages Cython \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN install -d /lab-host /lab-host/cases /lab-host/stacks /lab-host/verifications \
    && install -d -o ubuntu -g ubuntu \
        /work \
        /home/ubuntu/.cache \
        /home/ubuntu/.cache/ccache \
    && install -d -m 0700 -o ubuntu -g ubuntu /run/user/1000

COPY --chown=ubuntu:ubuntu entrypoint.sh selection.py /opt/xpra-lab-upstream-tests/

ENV CCACHE_DIR=/home/ubuntu/.cache/ccache \
    GITHUB_ACTIONS=1 \
    GITHUB_RUN_ATTEMPT=1 \
    HOME=/home/ubuntu \
    NO_AT_BRIDGE=1 \
    PATH=/usr/lib/ccache:${PATH} \
    XPRA_TEST_COVERAGE=1 \
    XDG_RUNTIME_DIR=/run/user/1000

USER ubuntu
WORKDIR /work
