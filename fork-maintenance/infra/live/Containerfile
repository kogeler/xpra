FROM docker.io/library/debian:13-slim AS client

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        dbus-x11 \
        gir1.2-gtk-3.0 \
        grim \
        iproute2 \
        libcairo2 \
        libdrm2 \
        libegl1 \
        libgbm1 \
        libgl1 \
        libgl1-mesa-dri \
        libglx-mesa0 \
        libgtk-3-0t64 \
        liblz4-1 \
        libpixman-1-0 \
        libstdc++6 \
        libva-drm2 \
        libva2 \
        libvulkan1 \
        libwayland-client0 \
        libx11-6 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxkbfile1 \
        libxpresent1 \
        libxres1 \
        libxtst6 \
        libyuv0 \
        mesa-utils \
        mesa-va-drivers \
        mesa-vulkan-drivers \
        openbox \
        picom \
        procps \
        python3 \
        python3-cairo \
        python3-dbus \
        python3-gi \
        python3-gi-cairo \
        python3-netifaces \
        python3-opengl \
        python3-pil \
        python3-seccomp \
        python3-setuptools \
        socat \
        sway \
        vainfo \
        vulkan-tools \
        x11-apps \
        x11-utils \
        x11-xserver-utils \
        xauth \
        xdotool \
        xfonts-base \
        xwayland \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=client-build /opt/xpra-install/ /
COPY container_payload.py /opt/xpra-lab/container_payload.py

RUN test -d /usr/local/share/xpra/css \
    && chmod 0755 /opt/xpra-lab/container_payload.py \
    && xpra --version \
    && python3 -c 'from xpra.codecs.libva import decoder, encoder' \
    && python3 -c 'from xpra.codecs.libyuv import converter' \
    && XPRA_RESOURCES_DIR=/usr/local/share/xpra \
        xvfb-run --auto-servernum python3 -c 'from xpra.client.gtk3 import client_base'

RUN useradd --create-home --uid 1001 --shell /bin/bash lab \
    && install -d -o lab -g lab -m 0700 /artifacts /run/user/1001

ENV XDG_RUNTIME_DIR=/run/user/1001
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER lab
WORKDIR /home/lab

CMD ["sleep", "infinity"]
