FROM docker.io/library/ubuntu:26.04 AS xpra-source-base

ARG DEBIAN_FRONTEND=noninteractive
ARG XPRA_COMMIT
ARG XPRA_SELECTION

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY source /src/xpra
COPY patches /tmp/xpra-fork-maintenance-patches

WORKDIR /src/xpra

RUN test -n "$XPRA_COMMIT" \
    && test -n "$XPRA_SELECTION" \
    && test -f xpra/src_info.py \
    && while IFS= read -r patch_name; do \
           test -z "$patch_name" && continue; \
           case "$patch_name" in \#*) continue ;; esac; \
           test -f "/tmp/xpra-fork-maintenance-patches/$patch_name"; \
           git apply --reverse --check --whitespace=error-all "/tmp/xpra-fork-maintenance-patches/$patch_name"; \
       done < /tmp/xpra-fork-maintenance-patches/already-present \
    && while IFS= read -r patch_name; do \
           test -z "$patch_name" && continue; \
           case "$patch_name" in \#*) continue ;; esac; \
           test -f "/tmp/xpra-fork-maintenance-patches/$patch_name"; \
           git apply --check --whitespace=error-all "/tmp/xpra-fork-maintenance-patches/$patch_name"; \
           git apply --whitespace=error-all "/tmp/xpra-fork-maintenance-patches/$patch_name"; \
       done < /tmp/xpra-fork-maintenance-patches/series


FROM xpra-source-base AS xpra-source


FROM docker.io/library/ubuntu:26.04 AS server-build

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        cython3 \
        git \
        libcairo2-dev \
        libdrm-dev \
        libgl-dev \
        libgtk-3-dev \
        liblz4-dev \
        libpixman-1-dev \
        libva-dev \
        libwayland-dev \
        libwlroots-0.19-dev \
        libx11-dev \
        libxcomposite-dev \
        libxdamage-dev \
        libxfixes-dev \
        libxkbcommon-dev \
        libxkbfile-dev \
        libxpresent-dev \
        libxres-dev \
        libxtst-dev \
        libyuv-dev \
        pkgconf \
        python-gi-dev \
        python3-cairo-dev \
        python3-dev \
        python3-setuptools \
        wayland-protocols \
    && rm -rf /var/lib/apt/lists/*

COPY --from=xpra-source /src/xpra /src/xpra

WORKDIR /src/xpra

RUN python3 setup.py install \
        --root=/opt/xpra-install \
        --prefix=/usr \
        --minimal \
        --with-argb_encoder \
        --with-cairo \
        --with-client \
        --with-clipboard \
        --with-csc_libyuv \
        --with-data \
        --with-dmabuf \
        --with-gtk3 \
        --with-gtk_x11 \
        --with-keyboard \
        --with-landlock \
        --with-libva_decoder \
        --with-libva_encoder \
        --with-lz4 \
        --with-mmap \
        --with-modules \
        --with-opengl \
        --with-pillow_decoder \
        --with-pillow_encoder \
        --with-rencodeplus \
        --with-scripts \
        --with-server \
        --with-ssl \
        --with-wayland_server \
        --with-x11 \
        --with-xinput

RUN package_dir="$(find /opt/xpra-install/usr/local/lib -type d -name dist-packages -print -quit)" \
    && test -n "$package_dir" \
    && PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
       python3 tests/unittests/unit/codecs/argb_test.py \
    && PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
       python3 tests/unittests/unit/codecs/rgb_transform_test.py \
    && PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
       python3 tests/unittests/unit/wayland/window_test.py \
    && if grep -q 'test_libyuv_RGBX_to_NV12' \
         tests/unittests/unit/codecs/csc_colorspace_test.py; then \
           PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
             python3 tests/unittests/unit/codecs/csc_colorspace_test.py \
               Test_CSC_Colorspace.test_libyuv_RGBX_to_NV12; \
       fi \
    && if test -f tests/unittests/unit/server/window/video_compress_test.py; then \
           PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
             python3 tests/unittests/unit/server/window/video_compress_test.py; \
       fi \
    && if test -f tests/unittests/unit/server/window/strict_video_modes_test.py; then \
           PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
             python3 tests/unittests/unit/server/window/strict_video_modes_test.py; \
       fi \
    && if grep -q 'test_reinit_encodings_log_format' \
         tests/unittests/unit/server/subsystem/encoding_test.py; then \
           PYTHONPATH="$package_dir:/src/xpra/tests/unittests" \
             python3 tests/unittests/unit/server/subsystem/encoding_test.py \
               EncodingMixinTest.test_reinit_encodings_log_format; \
       fi

# Fixture-only edits retain the preceding Xpra build and native-check layers.
COPY empty_damage_fixture.c /tmp/xpra-empty-damage-fixture.c
COPY subsurface_fixture.c /tmp/xpra-subsurface-fixture.c

RUN install -d /opt/xpra-install/usr/local/bin \
    && wayland-scanner client-header \
        /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
        /tmp/xdg-shell-client-protocol.h \
    && wayland-scanner private-code \
        /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
        /tmp/xdg-shell-protocol.c \
    && cc -std=c11 -O2 -Wall -Wextra -Werror \
        $(pkg-config --cflags wayland-client) \
        -I/tmp \
        /tmp/xpra-empty-damage-fixture.c \
        /tmp/xdg-shell-protocol.c \
        $(pkg-config --libs wayland-client) \
        -o /opt/xpra-install/usr/local/bin/xpra-empty-damage-fixture \
    && cc -std=c11 -O2 -Wall -Wextra -Werror \
        $(pkg-config --cflags wayland-client) \
        -I/tmp \
        /tmp/xpra-subsurface-fixture.c \
        /tmp/xdg-shell-protocol.c \
        $(pkg-config --libs wayland-client) \
        -o /opt/xpra-install/usr/local/bin/xpra-subsurface-fixture


FROM docker.io/library/ubuntu:26.04 AS server

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        dbus-x11 \
        gir1.2-gtk-3.0 \
        glmark2-wayland \
        iproute2 \
        libasound2t64 \
        libcairo2 \
        libdrm2 \
        libegl1 \
        libfontconfig1 \
        libfreetype6 \
        libgbm1 \
        libgl1 \
        libgl1-mesa-dri \
        libgtk-3-0t64 \
        liblz4-1 \
        libpixman-1-0 \
        libstdc++6 \
        libva-drm2 \
        libva2 \
        libvulkan1 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libwayland-server0 \
        libwlroots-0.19 \
        libx11-6 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxkbfile1 \
        libxpresent1 \
        libxres1 \
        libxtst6 \
        libyuv0 \
        mesa-utils \
        mesa-va-drivers \
        mesa-vulkan-drivers \
        procps \
        python3 \
        python3-cairo \
        python3-dbus \
        python3-gi \
        python3-gi-cairo \
        python3-netifaces \
        python3-opengl \
        python3-pil \
        python3-seccomp \
        python3-setuptools \
        vainfo \
        vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

COPY --from=server-build /opt/xpra-install/ /
COPY clipboard_fixture_common.py /opt/xpra-fork-maintenance/clipboard_fixture_common.py
COPY interaction_fixture.py /opt/xpra-fork-maintenance/interaction_fixture.py
COPY wayland_clipboard_fixture.py /opt/xpra-fork-maintenance/wayland_clipboard_fixture.py
COPY wayland_keyboard_fixture.py /opt/xpra-fork-maintenance/wayland_keyboard_fixture.py
COPY container_payload.py /opt/xpra-fork-maintenance/container_payload.py
COPY start_hardware_fixture.sh /opt/xpra-fork-maintenance/start_hardware_fixture.sh
COPY start_wayland_clipboard_fixture.sh /opt/xpra-fork-maintenance/start_wayland_clipboard_fixture.sh
COPY start_wayland_keyboard_fixture.sh /opt/xpra-fork-maintenance/start_wayland_keyboard_fixture.sh
COPY start_wayland_subsurface_fixture.sh /opt/xpra-fork-maintenance/start_wayland_subsurface_fixture.sh
COPY start_zed.sh /opt/xpra-fork-maintenance/start_zed.sh

RUN test -d /usr/local/share/xpra/css \
    && chmod 0644 /opt/xpra-fork-maintenance/clipboard_fixture_common.py \
    && chmod 0644 /opt/xpra-fork-maintenance/interaction_fixture.py \
    && chmod 0644 /opt/xpra-fork-maintenance/wayland_clipboard_fixture.py \
    && chmod 0644 /opt/xpra-fork-maintenance/wayland_keyboard_fixture.py \
    && chmod 0755 /opt/xpra-fork-maintenance/start_hardware_fixture.sh \
    && chmod 0755 /opt/xpra-fork-maintenance/start_wayland_clipboard_fixture.sh \
    && chmod 0755 /opt/xpra-fork-maintenance/start_wayland_keyboard_fixture.sh \
    && chmod 0755 /opt/xpra-fork-maintenance/start_wayland_subsurface_fixture.sh \
    && chmod 0755 /opt/xpra-fork-maintenance/start_zed.sh \
    && chmod 0755 /opt/xpra-fork-maintenance/container_payload.py \
    && xpra --version \
    && python3 -c 'from xpra.codecs.libva import decoder, encoder' \
    && python3 -c 'from xpra.codecs.libyuv import converter' \
    && python3 -c 'from xpra.clipboard import core' \
    && python3 -c 'from xpra.wayland.server.clipboard import WaylandClipboard' \
    && python3 -c 'from xpra.wayland.server import compositor' \
    && test -x /usr/local/bin/xpra-empty-damage-fixture \
    && test -x /usr/local/bin/xpra-subsurface-fixture

RUN useradd --create-home --uid 1001 --shell /bin/bash lab \
    && install -d -o lab -g lab -m 0700 /artifacts /run/user/1001

ENV XDG_RUNTIME_DIR=/run/user/1001
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER lab
WORKDIR /home/lab

RUN test -r /opt/xpra-fork-maintenance/interaction_fixture.py \
    && python3 -c "open('/opt/xpra-fork-maintenance/interaction_fixture.py', 'rb').read(1)" \
    && test -r /opt/xpra-fork-maintenance/wayland_keyboard_fixture.py \
    && test -r /opt/xpra-fork-maintenance/wayland_clipboard_fixture.py \
    && test -x /opt/xpra-fork-maintenance/start_wayland_clipboard_fixture.sh \
    && test -x /opt/xpra-fork-maintenance/start_wayland_keyboard_fixture.sh \
    && test -x /opt/xpra-fork-maintenance/start_wayland_subsurface_fixture.sh \
    && test -x /usr/local/bin/xpra-empty-damage-fixture \
    && test -x /usr/local/bin/xpra-subsurface-fixture

CMD ["sleep", "infinity"]


